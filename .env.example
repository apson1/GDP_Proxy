# Copy to .env and fill in. .env is gitignored.

# Google Earth Engine: the PROJECT ID from the Cloud console, not the project name.
# Looks like gdp-proxy-472913
GEE_PROJECT_ID=

# Boundary asset uploaded to Earth Engine once (see SETUP.md Part E). Embeds the
# project id, so it lives here rather than in committed config.
# Looks like projects/<your-project>/assets/boundaries_india_adm2_gee_upload
GEE_BOUNDARY_ASSET=

# Optional: Google Drive folder name that batch exports write to
GEE_EXPORT_FOLDER=gdp_proxy_exports

# Optional: GCS bucket if you export there instead of Drive
GEE_EXPORT_BUCKET=

# NASA Earthdata Login (only needed for direct Black Marble downloads)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
LAADS_TOKEN=

# Which country config block in config/countries.yaml to use
TARGET_COUNTRY=india
